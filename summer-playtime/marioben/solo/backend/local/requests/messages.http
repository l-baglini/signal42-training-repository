@token = REPLACE_WITH_ACCESS_TOKEN_FROM_LOGIN
@chatId = REPLACE_WITH_CHAT_UUID

### Sync a text-only message (no attachments part needed)
POST http://localhost:8088/chats/{{chatId}}/messages/sync
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="messages"
Content-Type: application/json

{
  "messages": [
    {
      "id": "msg_01JTEXT0000000000000000",
      "text": "Ciao, questo e' un messaggio di testo",
      "createdAt": 1755000000000
    }
  ]
}
--WebAppBoundary--

### Sync a message with one photo attachment.
### The file part name ("att_01JPHOTO...") must match the attachment "id" in the JSON.
POST http://localhost:8088/chats/{{chatId}}/messages/sync
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="messages"
Content-Type: application/json

{
  "messages": [
    {
      "id": "msg_01JMIXED000000000000000",
      "text": "Ecco il documento",
      "createdAt": 1755000000000,
      "attachments": [
        {
          "id": "att_01JPHOTO00000000000000",
          "contentType": "image/jpeg",
          "filename": "foto.jpg"
        }
      ]
    }
  ]
}
--WebAppBoundary
Content-Disposition: form-data; name="att_01JPHOTO00000000000000"; filename="foto.jpg"
Content-Type: image/jpeg

< ./sample-files/foto.jpg
--WebAppBoundary--
