# ---------------------------------------------------------------------------
# Claude authentication
# ---------------------------------------------------------------------------
# No API key required by default. The server drives the local `claude` CLI,
# which reuses the OAuth login of your Claude subscription
# (`npm run auth:login` -> opens the browser).
#
# Optional: path to the claude binary if it is not on PATH.
# CLAUDE_BIN=/home/you/.local/bin/claude
#
# Optional: long-lived token from `claude setup-token` (requires a Claude
# subscription). Only needed for headless/server deployments where no
# interactive browser login is possible.
# CLAUDE_CODE_OAUTH_TOKEN=

# Model used for title classification. Haiku is cheap and fast enough.
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Reddit source
# ---------------------------------------------------------------------------
# Adapter: "auto" | "oauth" | "rss"
#   oauth -> deeper history, needs a free "script" app at
#            https://www.reddit.com/prefs/apps (lifts the four-day ceiling)
#   rss   -> zero config, up to ~100 recent posts per subreddit
REDDIT_ADAPTER=auto
# Comma separated, read in parallel and merged chronologically (max 5).
REDDIT_SUBREDDITS=singularity,artificial
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:fight-ai:0.1.0 (local, non-commercial)

# ---------------------------------------------------------------------------
# Safety limits (see docs/SECURITY.md)
# ---------------------------------------------------------------------------
# Two subreddits over four days can exceed 200. Classification stops at the
# knockout anyway, so a higher cap costs nothing and avoids truncating the window.
MAX_POSTS=400
MAX_TITLE_CHARS=300
CLASSIFY_BATCH_SIZE=20
CLASSIFY_TIMEOUT_MS=90000
PORT=8787
