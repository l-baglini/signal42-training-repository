{
  "name": "lunch-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Centralizes office lunch requests across venues for the office manager — Onetag A7 Summer Build",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
