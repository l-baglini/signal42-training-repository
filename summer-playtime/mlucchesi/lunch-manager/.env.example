# Port the server listens on.
PORT=8900

# Where the SQLite database file lives.
DATABASE_PATH=./data/lunch-manager.sqlite

# Optional. Without it, "Generate message" falls back to the deterministic
# plain-list template instead of the AI-drafted one — the app works fine
# either way.
ANTHROPIC_API_KEY=

# Optional override, e.g. claude-haiku-4-5 for a cheaper/faster draft.
# Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=
